{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>redjax/PipelineTemplates//config/renovate/default#main"
  ],
  "dependencyDashboard": true,
  "pruneBranchAfterAutomerge": true,
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "pre-commit",
    "mise"
  ],
  "packageRules": [
    {
      "description": "Automatically merge stable patch and minor updates",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ]
}