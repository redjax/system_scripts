{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "dependencyDashboard": true,

  "packageRules": [
    {
      "description": "Automatically merge stable patch and minor updates",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ]
}